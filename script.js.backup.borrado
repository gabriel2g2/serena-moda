      <strong>Endereço de Entrega:</strong><br>
      <small>Rua: ${customer.shipping.street}</small><br>
      <small>Nº: ${customer.shipping.number || ''}</small><br>
      <small>Bairro: ${customer.shipping.neighborhood || ''}</small><br>
      <small>Cidade/UF: ${customer.shipping.city}, ${customer.shipping.state}</small><br>
      <small>CEP: ${formatZip(customer.shipping.zip)}</small>
    `;
    list.after(addressBlock);
  }
  
  const total = items.reduce((sum, item) => sum + parseFloat(item.price) * item.quantity, 0);
  
  if (modalElement.querySelector('#cartTotal')) {
    modalElement.querySelector('#cartTotal').textContent = formatPrice(total);
  }
  
  // Habilitar botão checkout se tiver endereço
  const checkoutBtn = modalElement.querySelector('#checkoutButton');
  if (checkoutBtn) {
    checkoutBtn.disabled = !customer?.shipping;
    if (customer?.shipping) {
      checkoutBtn.classList.remove('disabled-button');
    }
  }
  
  return true;
}
    // Mostrar mensagem de sucesso ou erro
    resetCheckoutMessage(modalElement);
    if (customer?.shipping) {
      const addressBlock = document.createElement("div");
      addressBlock.className = "mt-3 p-3 bg-light rounded";
      addressBlock.innerHTML = `
        <h6 class="mb-2">Endereço de Entrega:</h6>
        <p><strong>Rua:</strong> ${customer.shipping?.street || customer.address?.street}</p>
        <p><strong>Número:</strong> ${customer.shipping?.number || customer.address?.number || "N/A"}</p>
        <p><strong>Bairro:</strong> ${customer.shipping?.neighborhood || customer.address?.neighborhood || "N/A"}</p>
        <p><strong>Cidade/UF:</strong> ${customer.shipping?.city} - ${customer.shipping?.state || customer.address?.state || "N/A"}</p>
        <p><strong>CEP:</strong> ${formatZip(customer.shipping?.zip || customer.address?.zip)}</p>
      `;
      if (itemsContainer.nextElementSibling) itemsContainer.after(addressBlock);
      else itemsContainer.after(document.createElement("br"), addressBlock);
    }
    
    const checkoutButton = modalElement.querySelector("#checkoutButton");
    if (checkoutButton) {
      checkoutButton.disabled = false;
      checkoutButton.classList.remove("disabled-button");
    }
  }
}

