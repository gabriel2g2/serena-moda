            <strong>${item.name}</strong><br>
            <small>${formatPrice(parseFloat(item.price))} x ${item.quantity}</small>
          </div>
          <span>${formatPrice(parseFloat(item.price) * item.quantity)}</span>
        </div>
      </div>
    `).join('');
  }
  
